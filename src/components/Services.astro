---
// Leistungs-Tabs. Jede Leistung verlinkt auf ihre Unterseite (/leistungen/<slug>).
const services = [
  {
    slug: 'privatumzug',
    tab: 'Privatumzug',
    title: 'Sorgenfrei umziehen',
    text: 'Wir gestalten Ihren Privatumzug reibungslos und angenehm – vom Verpacken über den Transport bis zum Aufbau am neuen Ort. Sie freuen sich einfach auf Ihr neues Zuhause.',
    imgLabel: 'Foto: Privatumzug / Kartons tragen',
    icon: '<path d="M12 3l9 4.5v9L12 21l-9-4.5v-9z"></path><path d="M3 7.5L12 12l9-4.5M12 12v9"></path>',
  },
  {
    slug: 'firmenumzug',
    tab: 'Firmenumzug',
    title: 'Firmenumzug mit System',
    text: 'Büro- und Betriebsumzüge planen wir so, dass Ihr Betrieb mit minimaler Ausfallzeit weiterläuft – abends, am Wochenende oder etappenweise, ganz nach Ihrem Bedarf.',
    imgLabel: 'Foto: Büroumzug / Arbeitsplätze',
    icon: '<rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>',
  },
  {
    slug: 'entruempelung',
    tab: 'Entrümpelung',
    title: 'Entrümpelung & Haushaltsauflösung',
    text: 'Wohnungen, Keller, Dachböden oder komplette Haushaltsauflösungen – wir arbeiten diskret, zügig und übergeben besenrein. Auf Wunsch auch bei sensiblen Situationen mit besonderem Feingefühl.',
    imgLabel: 'Foto: Entrümpelung / Kellerraum',
    icon: '<path d="M6 3h12l1 10H5z"></path><path d="M9 13v5a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-5"></path>',
  },
  {
    slug: 'entsorgung',
    tab: 'Entsorgung',
    title: 'Fachgerechte Entsorgung',
    text: 'Alte Möbel, Sperrmüll und Elektrogeräte entsorgen wir fachgerecht und umweltbewusst. Verwertbares rechnen wir Ihnen an – das senkt Ihre Kosten spürbar.',
    imgLabel: 'Foto: Entsorgung / Transporter',
    icon: '<path d="M7 19l-3-5 3-2M17 5l3 5-3 2M10 5h4l2 4M14 19h-4l-2-4"></path>',
  },
];

const first = services[0];
const panelData = services.map((s) => ({
  title: s.title,
  text: s.text,
  imgLabel: s.imgLabel,
  href: `/leistungen/${s.slug}`,
}));
---
<section id="leistungen" class="pb-20 pt-10">
  <div class="wrap">
    <div data-reveal class="on-espresso rounded-[var(--radius-block)] bg-espresso p-[clamp(40px,6vw,80px)] text-white">
      <div class="mx-auto mb-11 max-w-[760px] text-center">
        <span class="badge badge-onDark mb-[22px]">Umfassende Umzugslösungen</span>
        <h2 class="m-0 mb-4 text-[clamp(30px,4.5vw,52px)] font-extrabold leading-[1.08] tracking-[-.02em]">
          Unsere Leistungen für Ihren Bedarf
        </h2>
        <p class="m-0 text-[18px] text-white/70">
          Von Privat- und Firmenumzügen bis zu Entrümpelung und fachgerechter Entsorgung – wählen Sie den
          Bereich, der zu Ihnen passt.
        </p>
      </div>

      <div class="tabs-scroll mb-11 max-[900px]:overflow-x-auto">
        <div
          role="tablist"
          aria-label="Leistungen"
          class="flex min-w-[560px] gap-2 rounded-[18px] bg-white/[.06] p-2"
        >
          {services.map((s, i) => (
            <button
              class:list={['svc-tab', { 'is-active': i === 0 }]}
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={i}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" stroke="#fff" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
              {s.tab}
            </button>
          ))}
        </div>
      </div>

      <div
        class="grid grid-cols-2 gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-9"
        data-tab-panel
        data-services={JSON.stringify(panelData)}
      >
        <div>
          <h3 data-tab-title class="m-0 mb-[18px] text-[clamp(26px,3.5vw,40px)] font-extrabold tracking-[-.01em]">
            {first.title}
          </h3>
          <p data-tab-text class="m-0 mb-[30px] text-[18px] text-white/[.72]">{first.text}</p>
          <a data-tab-link href={`/leistungen/${first.slug}`} class="btn btn-accent">
            Mehr erfahren <span class="arr text-[19px]">→</span>
          </a>
        </div>
        <div class="photo-ph h-[clamp(300px,36vw,420px)] items-end p-[22px]">
          <div data-parallax class="photo-fill" style="background:repeating-linear-gradient(45deg,#4a3a2c,#4a3a2c 14px,#42342780 14px,#423427 28px)"></div>
          <span
            data-tab-img
            class="relative rounded-lg bg-black/30 px-3 py-1.5 font-mono text-[12px] uppercase tracking-[.1em] text-white/[.72]"
            >{first.imgLabel}</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
