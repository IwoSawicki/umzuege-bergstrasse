---
import { FAQS } from '../data/home';
import { SITE } from '../config/site';
interface Props { items?: { q: string; a: string }[]; }
const { items = FAQS } = Astro.props;
---
<noscript><style>.faq-a{grid-template-rows:1fr}</style></noscript>
<section id="faq" class="pb-20 pt-5">
  <div class="wrap">
    <div class="grid grid-cols-[1.6fr_1fr] items-start gap-12 max-[900px]:grid-cols-1 max-[900px]:gap-8">
      <!-- FAQ-Spalte -->
      <div>
        <div data-reveal class="mb-8">
          <span class="badge mb-[18px]">Häufige Fragen</span>
          <h2 class="m-0 text-[clamp(30px,4vw,46px)] font-extrabold leading-[1.1] tracking-[-.02em]">Gut zu wissen</h2>
        </div>
        <div data-reveal data-faq class="flex flex-col gap-3">
          {items.map((f) => (
            <div class="faq-item overflow-hidden rounded-[18px] border border-[rgba(42,32,25,.08)] bg-white">
              <button class="faq-q flex w-full cursor-pointer items-center justify-between gap-4 border-0 bg-none p-[20px_24px] text-left text-[17px] font-semibold text-ink" type="button" aria-expanded="false">
                <span>{f.q}</span>
                <span class="faq-sign flex h-[30px] w-[30px] flex-shrink-0 items-center justify-center rounded-full bg-tint text-[20px] font-semibold text-accent" aria-hidden="true">+</span>
              </button>
              <div class="faq-a">
                <div class="faq-a-inner">
                  <p class="m-0 p-[0_24px_22px] text-[16.5px] leading-[1.6] text-muted">{f.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Kontaktkarte -->
      <aside data-reveal class="rounded-[24px] bg-espresso p-8 text-white max-[900px]:mt-2 min-[901px]:sticky min-[901px]:top-[100px]">
        <span class="inline-block rounded-full bg-white/10 px-3.5 py-1.5 text-[12.5px] font-semibold text-white/85">Persönlich für Sie da</span>
        <h3 class="m-0 mb-2 mt-4 text-[24px] font-extrabold leading-[1.15]">Noch Fragen offen?</h3>
        <p class="m-0 mb-6 text-[15.5px] leading-[1.55] text-white/70">
          Ihr persönlicher Ansprechpartner hilft Ihnen gern weiter – ganz unverbindlich und ohne Warteschleife.
        </p>

        <div class="mb-6 flex items-center gap-3">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-accent text-[16px] font-extrabold text-white" aria-hidden="true">IS</div>
          <div>
            <div class="text-[16px] font-bold">Iwo Sawicki</div>
            <div class="text-[13.5px] text-white/60">Umzüge Bergstraße</div>
          </div>
        </div>

        <div class="mb-6 flex flex-col gap-3 border-t border-white/10 pt-5">
          <a href={`tel:${SITE.contact.phoneHref}`} class="group flex items-center gap-3 text-white">
            <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-white/10 text-accent">
              <svg width="17" height="17" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none"><path d="M4 5c0 8 7 15 15 15l0-3-4-2-2 2c-2-1-5-4-6-6l2-2-2-4z"></path></svg>
            </span>
            <span class="text-[15.5px] font-semibold group-hover:text-accent">{SITE.contact.phone}</span>
          </a>
          <a href={`mailto:${SITE.contact.email}`} class="group flex items-center gap-3 text-white">
            <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-white/10 text-accent">
              <svg width="17" height="17" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
            </span>
            <span class="break-all text-[14.5px] font-medium text-white/85 group-hover:text-accent">{SITE.contact.email}</span>
          </a>
        </div>

        <a href={`tel:${SITE.contact.phoneHref}`} class="btn btn-accent w-full justify-center">
          <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" fill="none"><path d="M4 5c0 8 7 15 15 15l0-3-4-2-2 2c-2-1-5-4-6-6l2-2-2-4z"></path></svg>
          Jetzt anrufen
        </a>
      </aside>
    </div>
  </div>
</section>
