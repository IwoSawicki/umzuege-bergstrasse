---
import { SITE, isFilled } from '../config/site';
import RegionMap from './RegionMap.astro';

const phone = SITE.contact.phone;
const email = SITE.contact.email;
const address = isFilled(SITE.address.street)
  ? `${SITE.address.street}, ${SITE.address.postalCode} ${SITE.address.city}`
  : '[ADRESSE]';
const hours = SITE.openingHours;

// Kontakt-Icons
const icons = {
  phone: '<path d="M4 5c0 8 7 15 15 15l0-3-4-2-2 2c-2-1-5-4-6-6l2-2-2-4z"></path>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
  pin: '<path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle>',
  clock: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
};

const contactRows = [
  { key: 'phone', label: 'Telefon', value: phone, icon: icons.phone },
  { key: 'email', label: 'E-Mail', value: email, icon: icons.mail },
  ...(SITE.showAddress ? [{ key: 'address', label: 'Adresse', value: address, icon: icons.pin }] : []),
  { key: 'hours', label: 'Öffnungszeiten', value: hours, icon: icons.clock },
];
---
<section id="kontakt" class="pb-[90px] pt-5">
  <div class="wrap">
    <div data-reveal class="rounded-[var(--radius-block)] bg-tint p-[clamp(20px,5vw,64px)]">
      <div class="grid grid-cols-2 items-start gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-9">
        <!-- ======== Mehrstufiges Angebots-Formular ======== -->
        <div>
          <span class="accent-fill mb-5 inline-block rounded-full bg-accent px-4 py-[7px] text-[13px] font-semibold text-white">
            Kostenloses Angebot
          </span>
          <h2 class="m-0 mb-2 text-[clamp(28px,3.6vw,42px)] font-extrabold leading-[1.1] tracking-[-.02em]">
            Fordern Sie Ihr Angebot an
          </h2>
          <p class="m-0 mb-3 text-muted">Zwei Schritte, keine 30 Sekunden – und ganz ohne Verpflichtung.</p>
          <p class="m-0 mb-7 flex items-center gap-2 text-[15px] font-semibold text-accent-dark">
            <svg width="16" height="16" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            Nur begrenzte Termine pro Woche – sichern Sie sich Ihren Wunschtermin.
          </p>

          <!-- Erfolgsmeldung -->
          <div data-form-success hidden class="rounded-[18px] bg-white p-8 text-center">
            <div class="mb-2.5 text-[40px]">✓</div>
            <h3 class="m-0 mb-2 text-[22px] font-bold">Vielen Dank!</h3>
            <p class="m-0 mb-4 text-muted">Ihre Anfrage ist bei uns eingegangen. Wir melden uns meist innerhalb von 24 Stunden bei Ihnen.</p>
            <p class="m-0 rounded-xl bg-tint p-4 text-[15px] text-ink"><strong>Tipp:</strong> Halten Sie ein paar Fotos Ihrer Wohnung oder der Räume bereit – dann können wir Ihren Festpreis noch schneller kalkulieren.</p>
          </div>

          <!-- Fehlermeldung -->
          <div data-form-error hidden class="mb-4 rounded-[14px] border border-red-300 bg-red-50 p-4 text-[15px] text-red-800">
            Das hat leider nicht geklappt. Bitte versuchen Sie es erneut – oder rufen Sie uns direkt an:
            <a href={`tel:${SITE.contact.phoneHref}`} class="font-bold">{SITE.contact.phone}</a>
          </div>

          <form
            data-quote-form
            data-endpoint={`https://formsubmit.co/ajax/${SITE.leadEmail}`}
            class="quote-form flex flex-col gap-4"
            novalidate
            action={`https://formsubmit.co/${SITE.leadEmail}`}
            method="post"
          >
            <!-- FormSubmit-Konfiguration -->
            <input type="hidden" name="_subject" value="Neue Anfrage über umzuege-bergstrasse.de" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <!-- Honeypot gegen Spam-Bots -->
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;overflow:hidden" />
            <!-- Fortschritt (nur mit JS sichtbar) -->
            <div data-progress hidden class="mb-1">
              <div class="mb-2 flex items-center justify-between text-[13px] font-semibold text-muted">
                <span data-step-label>Schritt 1 von 2</span>
                <span data-step-percent>50 %</span>
              </div>
              <div class="h-[6px] w-full overflow-hidden rounded-full bg-black/10">
                <div data-progress-bar class="h-full rounded-full bg-accent transition-[width] duration-300" style="width:50%"></div>
              </div>
            </div>

            <!-- Schritt 1: Leistung -->
            <fieldset data-step class="m-0 border-0 p-0">
              <legend class="mb-3 block text-[19px] font-bold">Worum geht es?</legend>
              <div class="grid gap-3">
                {[
                  { v: 'Umzug', d: 'Privat- oder Firmenumzug' },
                  { v: 'Entrümpelung', d: 'Wohnung, Keller, Haushaltsauflösung' },
                  { v: 'Beides', d: 'Umzug inkl. Entrümpelung' },
                ].map((o, i) => (
                  <label class="choice-card">
                    <input type="radio" name="leistung" value={o.v} required checked={i === 0} class="sr-only" />
                    <span class="choice-check" aria-hidden="true"></span>
                    <span>
                      <span class="block font-semibold">{o.v}</span>
                      <span class="block text-sm text-muted">{o.d}</span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- Schritt 2: Kontaktdaten (inkl. Einwilligung – kein eigener Schritt mehr) -->
            <fieldset data-step class="m-0 border-0 p-0">
              <legend class="mb-3 block text-[19px] font-bold">Wie erreichen wir Sie?</legend>
              <div class="grid gap-4">
                <input name="name" autocomplete="name" placeholder="Name" required class="field" />
                <input name="telefon" type="tel" autocomplete="tel" placeholder="Telefonnummer" required class="field" />
                <input name="email" type="email" autocomplete="email" placeholder="E-Mail (optional)" class="field" />
                <textarea name="nachricht" rows="3" placeholder="Worum geht es genau? Gerne Größe, Termin und Adressen (optional)" class="field resize-y"></textarea>
              </div>
              <label class="mt-4 flex items-start gap-2.5 text-sm text-muted">
                <input type="checkbox" name="datenschutz" required class="mt-[3px]" />
                <span>Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu.</span>
              </label>
            </fieldset>

            <!-- Navigation. Auf schmalen Displays gestapelt: der Haupt-Button
                 bekommt die volle Breite, "Zurück" rutscht darunter. Nebeneinander
                 wurde "Angebot anfordern" sonst rechts abgeschnitten. -->
            <div class="mt-2 flex items-center gap-3 max-[560px]:flex-col-reverse max-[560px]:items-stretch">
              <button type="button" data-prev hidden class="btn !bg-white !px-5 !py-3 !text-ink">← Zurück</button>
              <button type="button" data-next class="btn btn-accent flex-1 max-[560px]:flex-none">
                Weiter <span class="arr text-[19px]">→</span>
              </button>
              <button type="submit" data-submit class="btn btn-accent flex-1 max-[560px]:flex-none">
                Angebot anfordern <span class="arr text-[19px]">→</span>
              </button>
            </div>

            <p class="m-0 mt-1 flex items-center justify-center gap-1.5 text-center text-[13.5px] text-muted">
              🔒 Ihre Daten werden vertraulich behandelt und nicht weitergegeben. Keine Werbeanrufe.
            </p>
          </form>
        </div>

        <!-- ======== Info-Karte ======== -->
        <div class="flex flex-col gap-6 rounded-[22px] bg-white p-9 max-[900px]:p-6">
          <div>
            <h3 class="m-0 mb-1.5 text-[22px] font-bold">Persönliche Beratung</h3>
            <p class="m-0 text-base text-muted">Antwort meist innerhalb von 24 Stunden.</p>
          </div>
          <div class="flex flex-col gap-[18px]">
            {contactRows.map((r) => (
              <div class="flex items-start gap-3.5">
                <div class="flex h-[42px] w-[42px] flex-shrink-0 items-center justify-center rounded-xl bg-tint text-accent">
                  <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" fill="none" set:html={r.icon} />
                </div>
                <div>
                  <div class="font-semibold">{r.label}</div>
                  {r.key === 'phone' ? (
                    <a href={`tel:${SITE.contact.phoneHref}`} class="text-muted hover:text-accent" data-contact="phone">{r.value}</a>
                  ) : r.key === 'email' ? (
                    <a href={`mailto:${SITE.contact.email}`} class="text-muted hover:text-accent" data-contact="email">{r.value}</a>
                  ) : (
                    <div class="text-muted" data-contact={r.key}>{r.value}</div>
                  )}
                </div>
              </div>
            ))}
          </div>
          <!-- Karte: eigene SVG-Karte (lädt nichts nach); die interaktive
               OpenStreetMap-Karte kommt aus Datenschutzgründen erst auf Klick. -->
          <div>
            <div data-map class="relative aspect-[420/224] overflow-hidden rounded-2xl bg-tint">
              <RegionMap />
            </div>
            <p class="m-0 mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-muted">
              Unser Einsatzgebiet an der Bergstraße und im Umland.
              <button
                type="button"
                data-map-load
                class="inline-flex cursor-pointer items-center gap-1 border-0 bg-transparent p-0 text-[13px] font-semibold text-accent underline-offset-2 hover:underline"
                aria-label="Interaktive OpenStreetMap-Karte des Einsatzgebiets laden"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true"><path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                Interaktive Karte
              </button>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Choice-Cards */
  .choice-card {
    display: flex; align-items: center; gap: 14px; cursor: pointer;
    background: #fff; border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-radius: 14px; padding: 16px 18px; transition: border-color .2s, box-shadow .2s, transform .2s;
  }
  .choice-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .choice-check {
    width: 22px; height: 22px; border-radius: 999px; flex-shrink: 0;
    border: 2px solid color-mix(in srgb, var(--ink) 25%, transparent); transition: all .2s;
  }
  .choice-card:has(input:checked) { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent); }
  .choice-card:has(input:checked) .choice-check { border-color: var(--accent); background: var(--accent) radial-gradient(circle, #fff 32%, transparent 36%); }
  .choice-card:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Ohne JS: alle Schritte sichtbar, Weiter/Zurück ausgeblendet, nur Submit */
  .quote-form [data-step] { display: block; margin-bottom: 8px; }
  .quote-form:not(.is-enhanced) [data-next],
  .quote-form:not(.is-enhanced) [data-prev] { display: none; }

  /* Mit JS (Stepper aktiv) */
  .quote-form.is-enhanced [data-step] { display: none; animation: stepIn .4s cubic-bezier(.22,1,.36,1); }
  .quote-form.is-enhanced [data-step].is-current { display: block; }
</style>

<script>
  import { trackLead } from '../scripts/track';
  function initQuoteForm() {
    document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
      const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'));
      if (steps.length < 2) return;

      const progress = form.querySelector<HTMLElement>('[data-progress]');
      const bar = form.querySelector<HTMLElement>('[data-progress-bar]');
      const label = form.querySelector<HTMLElement>('[data-step-label]');
      const percent = form.querySelector<HTMLElement>('[data-step-percent]');
      const prevBtn = form.querySelector<HTMLButtonElement>('[data-prev]');
      const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]');
      const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
      const success = form.parentElement?.querySelector<HTMLElement>('[data-form-success]');

      form.classList.add('is-enhanced');
      if (progress) progress.hidden = false;

      let idx = 0;
      const total = steps.length;

      // focusOnStep=false beim ersten Aufbau: iOS Safari ignoriert
      // preventScroll und würde sonst beim Laden zum Formular springen.
      const render = (focusOnStep = true) => {
        steps.forEach((s, i) => s.classList.toggle('is-current', i === idx));
        const pct = Math.round(((idx + 1) / total) * 100);
        if (bar) bar.style.width = pct + '%';
        if (label) label.textContent = `Schritt ${idx + 1} von ${total}`;
        if (percent) percent.textContent = pct + ' %';
        if (prevBtn) prevBtn.hidden = idx === 0;
        const last = idx === total - 1;
        if (nextBtn) nextBtn.style.display = last ? 'none' : 'inline-flex';
        if (submitBtn) submitBtn.style.display = last ? 'inline-flex' : 'none';
        // Fokus auf erstes Feld des Schritts
        if (focusOnStep) {
          const focusable = steps[idx].querySelector<HTMLElement>('input:not([type=radio]),select,textarea,[type=radio]:checked');
          focusable?.focus({ preventScroll: true });
        }
      };

      const validStep = () => {
        const fields = Array.from(
          steps[idx].querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea'),
        );
        for (const f of fields) {
          if (!f.checkValidity()) {
            f.reportValidity();
            return false;
          }
        }
        return true;
      };

      const go = (dir: number) => {
        if (dir > 0 && !validStep()) return;
        idx = Math.min(total - 1, Math.max(0, idx + dir));
        render();
      };

      nextBtn?.addEventListener('click', () => go(1));
      prevBtn?.addEventListener('click', () => go(-1));

      // Auswahl-Karten (Schritt 1) → automatisch weiter (auch bei Klick auf die
      // bereits vorausgewählte Karte)
      steps[0].querySelectorAll<HTMLElement>('.choice-card').forEach((card) =>
        card.addEventListener('click', () => setTimeout(() => { if (idx === 0) go(1); }, 180)),
      );

      // Enter = weiter (außer in Textarea)
      form.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !(e.target instanceof HTMLTextAreaElement)) {
          if (idx < total - 1) {
            e.preventDefault();
            go(1);
          }
        }
      });

      const errorBox = form.parentElement?.querySelector<HTMLElement>('[data-form-error]');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!validStep()) return;
        const endpoint = form.dataset.endpoint;
        if (!endpoint) return;

        if (errorBox) errorBox.hidden = true;
        const originalLabel = submitBtn?.innerHTML || '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Wird gesendet …';
        }
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          trackLead('anfrageformular');
          form.style.display = 'none';
          if (progress) progress.hidden = true;
          if (success) success.hidden = false;
          success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch {
          if (errorBox) {
            errorBox.hidden = false;
            errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalLabel;
          }
        }
      });

      render(false); // ohne Fokus -> kein ungewolltes Scrollen beim Laden
    });
  }

  // Karte (OpenStreetMap) erst auf Klick laden – DSGVO-freundliche Zwei-Klick-Lösung
  function initMap() {
    document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const wrap = btn.closest<HTMLElement>('[data-map]');
        if (!wrap) return;
        const iframe = document.createElement('iframe');
        // Ausschnitt: Einsatzgebiet Bergstraße (Weinheim–Bensheim–Zwingenberg)
        iframe.src =
          'https://www.openstreetmap.org/export/embed.html?bbox=8.50%2C49.50%2C8.75%2C49.76&layer=mapnik';
        iframe.title = 'Einsatzgebiet an der Bergstraße (OpenStreetMap)';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer';
        iframe.className = 'absolute inset-0 h-full w-full border-0';
        wrap.innerHTML = '';
        wrap.appendChild(iframe);
      });
    });
  }

  function init() {
    initQuoteForm();
    initMap();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
