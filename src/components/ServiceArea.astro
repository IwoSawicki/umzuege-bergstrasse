---
import { AREAS } from '../data/home';
---
<section class="pb-20 pt-5">
  <div class="wrap max-w-[820px] text-center">
    <div data-reveal>
      <span class="badge mb-[22px]">Einsatzgebiet</span>
      <h2 class="m-0 mb-4 text-[clamp(28px,3.6vw,40px)] font-extrabold leading-[1.12] tracking-[-.02em]">
        Für Sie da an der ganzen <span class="text-accent">Bergstraße</span>
      </h2>
      <p class="m-0 mb-8 text-[18px] text-muted">
        Wir sind in Bensheim und weit darüber hinaus im Einsatz – zwischen Odenwald und Rhein.
      </p>
      <div class="flex flex-wrap justify-center gap-[10px]" data-stagger>
        {AREAS.map((ort) =>
          ort.slug ? (
            <a href={`/umzug/${ort.slug}`} class="chip">{ort.name}</a>
          ) : (
            <span class="chip">{ort.name}</span>
          )
        )}
      </div>
    </div>
  </div>
</section>
