---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-v3.jpeg';
import { SITE } from '../config/site';

interface Props {
  /** Bildbeschreibung – auf Landingpages passend zur Leistung. */
  imageAlt?: string;
  /** WhatsApp-Knopf neben der Telefonnummer zeigen (Landingpages).
      Erscheint nur, wenn in site.ts auch eine Nummer hinterlegt ist. */
  whatsapp?: boolean;
  titleLead?: string;
  titleRest?: string;
  highlight?: string;
  subtitle?: string;
}
const {
  whatsapp = false,
  imageAlt = 'Zwei Mitarbeiter von Umzüge Bergstraße beladen den Transporter mit Umzugskartons',
  titleLead = 'Stressfrei umziehen &',
  titleRest = 'entrümpeln an der',
  highlight = 'Bergstraße',
  subtitle = 'Persönlich, zuverlässig und aus einer Hand – vom sorgfältigen Privatumzug bis zur diskreten Haushaltsauflösung in Südhessen.',
} = Astro.props;

const waNummer = SITE.contact.whatsapp;
const zeigeWa = whatsapp && Boolean(waNummer);
---
<section id="top" class="pt-[70px] max-[560px]:pt-10">
  <div class="wrap max-w-[920px] text-center">
    <h1
      data-reveal
      /* Bewusst KEIN hyphens:auto. Das trennt sonst auch den Markennamen
         ("Berg-/straße"). Lange Woerter bekommen stattdessen ein weiches
         Trennzeichen (&shy;) direkt im Text – siehe entruempelung.md.
         overflow-wrap bleibt als letzte Reissleine: lieber ein haesslicher
         Umbruch als ein Wort, das body{overflow-x:hidden} abschneidet. */
      class="m-0 mb-[22px] text-[clamp(38px,6vw,72px)] font-extrabold leading-[1.04] tracking-[-.02em] [overflow-wrap:break-word]"
    >
      {titleLead && <span class="block">{titleLead}</span>}<span set:html={titleRest}></span>{' '}<span class="text-accent" set:html={highlight}></span>
    </h1>
    <p data-reveal class="mx-auto mb-[30px] max-w-[640px] text-[19px] text-muted [text-wrap:pretty]">
      {subtitle}
    </p>
    <div data-reveal class:list={['mx-auto flex flex-wrap items-stretch justify-center gap-3', zeigeWa ? 'max-w-[560px]' : 'max-w-[500px]']}>
      <a href="/#kontakt" class="btn btn-accent min-w-0 flex-1 whitespace-nowrap max-[420px]:!px-2 max-[420px]:!text-[14px]">
        Angebot anfordern
      </a>
      <a href={`tel:${SITE.contact.phoneHref}`} class="btn btn-outline min-w-0 flex-1 whitespace-nowrap max-[420px]:!px-2 max-[420px]:!text-[14px]">
        <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none" class="max-[560px]:hidden"><path d="M4 5c0 8 7 15 15 15l0-3-4-2-2 2c-2-1-5-4-6-6l2-2-2-4z"></path></svg>
        {SITE.contact.phone}
      </a>
      {zeigeWa && (
        <a
          href={`https://wa.me/${waNummer}`}
          target="_blank"
          rel="noopener"
          data-contact="whatsapp"
          class="btn btn-outline min-w-0 flex-1 whitespace-nowrap max-[560px]:!basis-full max-[420px]:!px-2 max-[420px]:!text-[14px]"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24zm-2.5 4.1c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28s-1.44-.71-1.66-.79c-.22-.08-.39-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.45-1.35-1.69-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.79-.19-.46-.39-.4-.54-.41h-.47z"></path></svg>
          WhatsApp
        </a>
      )}
    </div>
  </div>

  <div class="wrap mt-[54px] max-[560px]:mt-9">
    <div data-reveal class="photo-ph h-[min(58vh,520px)] max-[560px]:h-[76vw]">
      <Image
        src={heroImg}
        alt={imageAlt}
        data-parallax
        class="photo-fill object-cover"
        widths={[768, 1200, 1774, 2200]}
        sizes="(max-width: 1180px) 100vw, 1180px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
