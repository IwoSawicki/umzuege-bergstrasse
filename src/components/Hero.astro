---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-transporter.webp';
import { SITE } from '../config/site';

interface Props {
  titleLead?: string;
  titleRest?: string;
  highlight?: string;
  subtitle?: string;
}
const {
  titleLead = 'Stressfrei umziehen &',
  titleRest = 'entrümpeln an der',
  highlight = 'Bergstraße',
  subtitle = 'Persönlich, zuverlässig und aus einer Hand – vom sorgfältigen Privatumzug bis zur diskreten Haushaltsauflösung in Südhessen.',
} = Astro.props;
---
<section
  id="top"
  class="pt-[70px] max-[560px]:pt-10"
  style="background-image:linear-gradient(rgba(42,32,25,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(42,32,25,.045) 1px,transparent 1px);background-size:64px 64px;background-position:center"
>
  <div class="wrap max-w-[920px] text-center">
    <h1
      data-reveal
      class="m-0 mb-[22px] text-[clamp(38px,6vw,72px)] font-extrabold leading-[1.04] tracking-[-.02em]"
    >
      <span class="block">{titleLead}</span>{titleRest}{' '}<span class="text-accent" set:html={highlight}></span>
    </h1>
    <p data-reveal class="mx-auto mb-[30px] max-w-[640px] text-[19px] text-muted [text-wrap:pretty]">
      {subtitle}
    </p>
    <div data-reveal class="flex flex-wrap items-center justify-center gap-3">
      <a href="/#kontakt" class="btn btn-accent !px-[26px] !py-[14px] !text-[16px]">
        Angebot anfordern <span class="arr text-[19px]">→</span>
      </a>
      <a href={`tel:${SITE.contact.phoneHref}`} class="btn btn-outline">
        <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none"><path d="M4 5c0 8 7 15 15 15l0-3-4-2-2 2c-2-1-5-4-6-6l2-2-2-4z"></path></svg>
        {SITE.contact.phone}
      </a>
    </div>
  </div>

  <div class="wrap mt-[54px]">
    <div data-reveal class="photo-ph h-[min(58vh,520px)]">
      <Image
        src={heroImg}
        alt="Transporter von Umzüge Bergstraße – beladebereit an der Straße"
        data-parallax
        class="photo-fill object-cover"
        widths={[768, 1200, 1774]}
        sizes="(max-width: 1180px) 100vw, 1180px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
