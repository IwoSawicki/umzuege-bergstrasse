---
/**
 * Rückruf-Sektion direkt unter der Hero.
 * Bewusst minimal: nur Name + Telefon – die niedrigste Hürde für eine
 * Kontaktaufnahme.
 *
 * Komplett neu gebaut, nachdem der Versand wiederholt scheiterte, während
 * das grosse Anfrageformular mit identischem Code und identischem Endpunkt
 * durchging. Zwei Dinge sind deshalb anders als vorher:
 *
 * 1. KEIN Honeypot-Feld mehr. `_honey` ist bei FormSubmit ein echtes
 *    Textfeld, das nur aus dem sichtbaren Bereich geschoben wird. Hier war
 *    es eines von drei Textfeldern (im grossen Formular eines von acht) –
 *    und Browser-Autofill greift bei kurzen Formularen deutlich eher auf
 *    unbeschriftete Felder zu. Ein gefuelltes Honeypot-Feld wertet
 *    FormSubmit als Bot und weist die Anfrage ab.
 *
 * 2. Schlaegt der Versand trotzdem fehl, ist die Anfrage nicht verloren:
 *    Die Fehlermeldung bietet dann WhatsApp mit bereits eingetragenem Namen
 *    und Nummer an, dazu die Telefonnummer zum Antippen.
 */
import { SITE } from '../config/site';

interface Props {
  /** Betreff der Mail – macht in der Inbox sofort sichtbar, welche Seite den Lead gebracht hat. */
  subject?: string;
}
const { subject = 'Rückruf-Wunsch über umzuege-bergstrasse.de' } = Astro.props;

const waNummer = SITE.contact.whatsapp;
const waText = encodeURIComponent('Hallo, ich hätte gerne ein Angebot für einen Umzug bzw. eine Entrümpelung.');
const waHref = waNummer ? `https://wa.me/${waNummer}?text=${waText}` : '';

const waIcon =
  '<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24zm-2.5 4.1c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28s-1.44-.71-1.66-.79c-.22-.08-.39-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.45-1.35-1.69-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.79-.19-.46-.39-.4-.54-.41h-.47z"></path>';
const telIcon = '<path d="M4 5c0 8 7 15 15 15l0-3-4-2-2 2c-2-1-5-4-6-6l2-2-2-4z"></path>';
---
<section id="rueckruf" class="pt-12 max-[560px]:pt-8">
  <div class="wrap">
    <div data-reveal class="rounded-[var(--radius-block)] bg-tint p-[clamp(24px,4vw,44px)]">
      <div class="grid grid-cols-[1.05fr_1fr] items-center gap-10 max-[900px]:grid-cols-1 max-[900px]:gap-7">
        <!-- Text -->
        <div>
          <span class="accent-fill mb-4 inline-flex items-center gap-2 rounded-full bg-accent px-4 py-[7px] text-[13px] font-semibold text-white">
            <svg width="15" height="15" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" set:html={telIcon} />
            Rückruf-Service
          </span>
          <h2 class="m-0 mb-3 text-[clamp(24px,3.2vw,36px)] font-extrabold leading-[1.12] tracking-[-.02em]">
            Innerhalb von 4 Stunden einen <span class="text-accent">Rückruf</span> erhalten
          </h2>
          <p class="m-0 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[16px] text-muted">
            <span class="inline-flex items-center gap-2">
              <svg width="17" height="17" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none" class="text-accent"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
              Montag bis Samstag, 8–20 Uhr
            </span>
            <span class="inline-flex items-center gap-2">
              <svg width="17" height="17" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none" class="text-accent"><path d="M20 6L9 17l-5-5"></path></svg>
              Kostenlos &amp; unverbindlich
            </span>
          </p>
        </div>

        <!-- Formular -->
        <div>
          <div data-cb-success hidden class="rounded-[18px] bg-white p-6 text-center">
            <div class="mb-1.5 text-[32px]">✓</div>
            <h3 class="m-0 mb-1 text-[19px] font-bold">Danke – wir rufen zurück!</h3>
            <p class="m-0 text-[15px] text-muted">Innerhalb von 4 Stunden (Mo–Sa, 8–20 Uhr).</p>
          </div>

          <!-- Fehlerfall: die Anfrage soll trotzdem bei uns ankommen -->
          <div data-cb-error hidden class="mb-3 rounded-[16px] border border-red-200 bg-red-50 p-4">
            <p class="m-0 mb-3 text-[14.5px] leading-[1.5] text-red-800">
              Die Anfrage kam gerade nicht durch. Bitte schreiben Sie uns kurz – das geht sofort:
            </p>
            <div class="flex flex-wrap gap-2.5">
              {waHref && (
                <a
                  data-cb-wa
                  href={waHref}
                  target="_blank"
                  rel="noopener"
                  data-contact="whatsapp"
                  class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-2.5 text-[15px] font-bold text-white"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={waIcon} />
                  Per WhatsApp
                </a>
              )}
              <a
                href={`tel:${SITE.contact.phoneHref}`}
                data-contact="phone"
                class="inline-flex items-center gap-2 rounded-full border border-[rgba(42,32,25,.2)] bg-white px-5 py-2.5 text-[15px] font-semibold text-ink"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none" aria-hidden="true" set:html={telIcon} />
                {SITE.contact.phone}
              </a>
            </div>
          </div>

          <form
            data-cb-form
            data-endpoint={`https://formsubmit.co/ajax/${SITE.leadEmail}`}
            action={`https://formsubmit.co/${SITE.leadEmail}`}
            method="post"
            novalidate
            class="flex flex-col gap-3"
          >
            {/* Kein _honey: siehe Kommentar oben. */}
            <input type="hidden" name="_subject" value={subject} />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_replyto" value={SITE.leadEmail} />
            <input type="hidden" name="leistung" value="Rückruf" />
            <input type="hidden" name="nachricht" value="Rückruf gewünscht – bitte anrufen." />

            <div class="grid grid-cols-2 gap-3 max-[560px]:grid-cols-1">
              <input name="name" autocomplete="name" placeholder="Ihr Name" required class="field" aria-label="Name" />
              <input name="telefon" type="tel" autocomplete="tel" placeholder="Ihre Telefonnummer" required class="field" aria-label="Telefonnummer" />
            </div>
            <button type="submit" data-cb-submit class="btn btn-accent w-full justify-center">
              Rückruf anfordern <span class="arr text-[19px]">→</span>
            </button>
            <p class="m-0 text-center text-[13px] text-muted">
              🔒 Nur für Ihren Rückruf. Keine Werbeanrufe.
            </p>
          </form>

          <div class="mt-4 flex items-center gap-3 border-t border-[rgba(42,32,25,.12)] pt-4">
            <span class="text-[13.5px] text-muted">Lieber sofort?</span>
            {waHref && (
              <a
                href={waHref}
                target="_blank"
                rel="noopener"
                data-contact="whatsapp"
                class="inline-flex items-center gap-1.5 text-[14.5px] font-semibold text-[#1F8F4E]"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={waIcon} />
                WhatsApp
              </a>
            )}
            <a
              href={`tel:${SITE.contact.phoneHref}`}
              data-contact="phone"
              class="inline-flex items-center gap-1.5 text-[14.5px] font-semibold text-accent-dark"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" fill="none" aria-hidden="true" set:html={telIcon} />
              {SITE.contact.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackLead, trackAdsConversion } from '../scripts/track';
  import { sendeFormular } from '../scripts/formsubmit';

  function initCallback() {
    document.querySelectorAll<HTMLFormElement>('[data-cb-form]').forEach((form) => {
      const wrap = form.parentElement;
      const success = wrap?.querySelector<HTMLElement>('[data-cb-success]');
      const errorBox = wrap?.querySelector<HTMLElement>('[data-cb-error]');
      const waLink = errorBox?.querySelector<HTMLAnchorElement>('[data-cb-wa]');
      const btn = form.querySelector<HTMLButtonElement>('[data-cb-submit]');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const name = (form.querySelector<HTMLInputElement>('[name=name]')?.value || '').trim();
        const telefon = (form.querySelector<HTMLInputElement>('[name=telefon]')?.value || '').trim();

        if (errorBox) errorBox.hidden = true;
        const label = btn?.innerHTML || '';
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Wird gesendet …';
        }

        const ergebnis = await sendeFormular(form, form.dataset.endpoint || '');

        if (ergebnis.ok) {
          trackLead('rueckruf');
          trackAdsConversion('formular');
          form.style.display = 'none';
          if (success) success.hidden = false;
        } else if (errorBox) {
          // Die Eingaben in den WhatsApp-Text übernehmen, damit der Besucher
          // sie nicht noch einmal tippen muss.
          if (waLink) {
            const text =
              `Hallo, ich hätte gerne einen Rückruf.\n\nName: ${name}\nTelefon: ${telefon}`;
            waLink.href = waLink.href.split('?')[0] + '?text=' + encodeURIComponent(text);
          }
          errorBox.hidden = false;
          errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        if (btn) {
          btn.disabled = false;
          btn.innerHTML = label;
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCallback);
  } else {
    initCallback();
  }
</script>
