---
import { Image } from 'astro:assets';
import aboutImg from '../assets/ueber-uns-treppe.jpg';
---
<section id="warum" class="pb-20 pt-10">
  <div class="wrap grid grid-cols-2 items-center gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-9">
    <div data-reveal class="photo-ph h-[clamp(340px,42vw,480px)]">
      <Image
        src={aboutImg}
        alt="Umzugshelfer trägt sorgfältig Umzugskartons durchs Treppenhaus"
        data-parallax
        class="photo-fill object-cover"
        widths={[560, 900, 1200]}
        sizes="(max-width: 900px) 100vw, 560px"
        loading="lazy"
      />
    </div>
    <div data-reveal>
      <span class="badge mb-[22px]">Warum Bergstraße Umzüge?</span>
      <h2 class="m-0 mb-5 text-[clamp(30px,4vw,46px)] font-extrabold leading-[1.1] tracking-[-.02em]">
        Ihr erfahrener Umzugs- und Entrümpelungspartner in der <span class="text-accent">Region</span>
      </h2>
      <p class="m-0 mb-[30px] text-[18px] text-muted">
        Wir sind ein regionaler Umzugs- und Entrümpelungsbetrieb an der Bergstraße – mit vollem Einsatz,
        modernem Equipment und einem persönlichen Anspruch. Als Menschen von hier kennen wir die Wege, die
        Häuser und die Nachbarschaft. Ein eingespieltes Team, ein fairer Festpreis und ein respektvoller
        Umgang mit Ihrem Eigentum stehen bei uns an erster Stelle.
      </p>
      <a href="/#kontakt" class="btn btn-dark">Angebot anfordern <span class="arr text-[19px]">→</span></a>
    </div>
  </div>
</section>
