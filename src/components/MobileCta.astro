---
import { SITE, isFilled } from '../config/site';
const telHref = isFilled(SITE.contact.phoneHref) ? `tel:${SITE.contact.phoneHref}` : '/#kontakt';
---
<div class="mobile-bar fixed inset-x-0 bottom-0 z-[60] hidden gap-2.5 border-t border-[rgba(42,32,25,.1)] bg-[rgba(251,245,236,.9)] p-[10px_14px] backdrop-blur-[8px] max-[900px]:flex">
  <a href={telHref} class="flex flex-1 items-center justify-center gap-2 rounded-full border border-[rgba(42,32,25,.14)] bg-white p-3.5 font-semibold text-ink">Anrufen</a>
  <a href="/#kontakt" class="flex flex-1 items-center justify-center gap-2 rounded-full bg-espresso p-3.5 font-semibold text-white">Angebot anfordern</a>
</div>
