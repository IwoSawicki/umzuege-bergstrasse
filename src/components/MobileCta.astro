---
/**
 * Mobile Aktionsleiste am unteren Rand.
 *
 * Links WhatsApp als Haupt-CTA: Wer entrümpeln oder umziehen lässt, schickt
 * lieber drei Fotos vom Keller als ein Formular auszufüllen. Rechts ein
 * Menü-Sheet mit Navigation und allen Kontaktwegen.
 *
 * WhatsApp behält sein eigenes Grün statt der Markenfarbe – der Knopf wird
 * dadurch sofort erkannt, und der Nutzer weiß, was ihn nach dem Tippen
 * erwartet. Das ist mehr wert als Farbtreue an dieser einen Stelle.
 *
 * Die Leiste erscheint erst nach etwas Scrollen (siehe ui.ts), damit sie
 * nicht die Knöpfe in der Hero überdeckt.
 */
import { NAV, SITE, isFilled } from '../config/site';

const telHref = isFilled(SITE.contact.phoneHref) ? `tel:${SITE.contact.phoneHref}` : '/#kontakt';
const waNummer = SITE.contact.whatsapp;
const waText = encodeURIComponent(
  'Hallo, ich interessiere mich für einen Umzug bzw. eine Entrümpelung. Können Sie mir ein Angebot machen?',
);
const waHref = waNummer ? `https://wa.me/${waNummer}?text=${waText}` : '';

const icons = {
  whatsapp:
    '<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24zm-2.5 4.1c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28s-1.44-.71-1.66-.79c-.22-.08-.39-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.45-1.35-1.69-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.79-.19-.46-.39-.4-.54-.41h-.47z"></path>',
  phone: '<path d="M4 5c0 8 7 15 15 15l0-3-4-2-2 2c-2-1-5-4-6-6l2-2-2-4z"></path>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
  form: '<path d="M4 4h16v16H4z"></path><path d="M8 9h8M8 13h8M8 17h5"></path>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path>',
};

/** Kontaktwege im Sheet – nach Aufwand für den Besucher sortiert. */
const kontakte = [
  ...(waHref
    ? [{ href: waHref, label: 'Per WhatsApp schreiben', icon: icons.whatsapp, extern: true, wa: true }]
    : []),
  { href: telHref, label: 'Jetzt anrufen', icon: icons.phone, tel: true },
  { href: '/#rueckruf', label: 'Rückruf vereinbaren', icon: icons.calendar },
  { href: '/#kontakt', label: 'Angebot anfordern', icon: icons.form },
  { href: `mailto:${SITE.contact.email}`, label: 'E-Mail schreiben', icon: icons.mail },
];
---
<!-- Sheet: liegt über der Leiste und wird von ihr aus geöffnet -->
<div
  data-cta-sheet
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Menü und Kontakt"
  class="fixed inset-0 z-[70] max-[900px]:block min-[901px]:hidden"
>
  <div data-cta-backdrop class="absolute inset-0 bg-espresso/45 backdrop-blur-[2px]"></div>

  <div
    data-cta-panel
    class="absolute inset-x-3 bottom-[86px] overflow-hidden rounded-[26px] bg-[rgba(247,243,237,.97)] shadow-[0_18px_60px_rgba(42,32,25,.35)] backdrop-blur-[14px]"
  >
    <nav class="flex flex-col px-5 pt-4" aria-label="Seitenbereiche">
      {NAV.map((item) => (
        <a href={item.href} data-cta-close class="cta-zeile justify-center text-[19px] font-semibold text-ink">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mx-5 border-t border-[rgba(42,32,25,.16)]"></div>

    <div class="flex flex-col px-5 pb-4 pt-2">
      {kontakte.map((k) => (
        <a
          href={k.href}
          data-cta-close
          data-contact={k.tel ? 'phone' : undefined}
          target={k.extern ? '_blank' : undefined}
          rel={k.extern ? 'noopener' : undefined}
          class:list={['cta-zeile gap-3 text-[17px] font-semibold', k.wa ? 'text-[#1F8F4E]' : 'text-ink']}
        >
          <svg
            width="21" height="21" viewBox="0 0 24 24" aria-hidden="true"
            fill={k.wa ? 'currentColor' : 'none'}
            stroke={k.wa ? 'none' : 'currentColor'}
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
            set:html={k.icon}
          />
          {k.label}
        </a>
      ))}
    </div>
  </div>
</div>

<!-- Leiste -->
<div
  data-mobile-cta
  class="mobile-bar fixed inset-x-0 bottom-0 z-[60] hidden gap-2.5 p-[10px_14px_calc(10px+env(safe-area-inset-bottom))] max-[900px]:flex"
>
  {waHref ? (
    <a
      href={waHref}
      target="_blank"
      rel="noopener"
      data-contact="whatsapp"
      class="wa-knopf flex flex-[1.35] items-center justify-center gap-2 rounded-full p-3.5 text-[16px] font-bold text-white"
    >
      <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons.whatsapp} />
      WhatsApp
    </a>
  ) : (
    <a href={telHref} data-contact="phone" class="flex flex-[1.35] items-center justify-center gap-2 rounded-full border border-[rgba(42,32,25,.14)] bg-white p-3.5 font-semibold text-ink">
      <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none" aria-hidden="true" set:html={icons.phone} />
      Anrufen
    </a>
  )}

  <button
    type="button"
    data-cta-toggle
    aria-expanded="false"
    class="flex flex-1 items-center justify-center gap-2.5 rounded-full border border-[rgba(42,32,25,.14)] bg-white p-3.5 text-[16px] font-semibold text-ink"
  >
    Menü
    <span data-cta-punkte class="cta-punkte" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </span>
  </button>
</div>

<style is:global>
  /* Erscheint erst nach etwas Scrollen – sonst verdeckt sie die Hero-Knöpfe */
  .mobile-bar {
    transform: translateY(120%);
    opacity: 0;
    transition: transform .34s cubic-bezier(.22, 1, .36, 1), opacity .24s;
    pointer-events: none;
  }
  .mobile-bar.is-sichtbar { transform: none; opacity: 1; pointer-events: auto; }

  .wa-knopf { background: #25D366; box-shadow: 0 6px 18px rgba(37, 211, 102, .34); }
  .wa-knopf:active { background: #1EB558; }

  /* 3x3-Punkteraster wie im Vorbild */
  .cta-punkte { display: grid; grid-template-columns: repeat(3, 3px); gap: 3px; }
  .cta-punkte i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }

  .cta-zeile {
    display: flex; align-items: center;
    padding: 13px 4px; border-radius: 12px;
    transition: background .15s;
  }
  .cta-zeile:active { background: rgba(42, 32, 25, .07); }

  [data-cta-sheet][hidden] { display: none !important; }
  [data-cta-panel] { animation: sheetHoch .3s cubic-bezier(.22, 1, .36, 1); }
  [data-cta-backdrop] { animation: sheetEin .25s ease; }
  @keyframes sheetHoch { from { transform: translateY(18px); opacity: 0; } }
  @keyframes sheetEin { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .mobile-bar { transition: none; }
    [data-cta-panel], [data-cta-backdrop] { animation: none; }
  }
</style>
