---
/**
 * Mobile Aktionsleiste am unteren Rand.
 *
 * Links WhatsApp als Haupt-CTA: Wer entrümpeln oder umziehen lässt, schickt
 * lieber drei Fotos vom Keller als ein Formular auszufüllen. Rechts öffnet
 * "Menü" ein Sheet.
 *
 * Das Sheet hatte vorher neun gleich gewichtete Einträge – vier Sprungmarken
 * plus fünf konkurrierende Kontaktwege, beige auf beige. Wer fünf Wege
 * angeboten bekommt, wählt keinen. Jetzt: vier echte Seiten und genau zwei
 * Kontaktwege, auf dunklem Markenhintergrund mit Logo und Begrüßung.
 *
 * WhatsApp behält sein eigenes Grün. Der Knopf wird dadurch sofort erkannt,
 * und man weiß vorher, was nach dem Tippen passiert.
 *
 * Die Leiste erscheint erst nach etwas Scrollen (siehe ui.ts), damit sie
 * nicht die Knöpfe in der Hero überdeckt.
 */
import { SITE, isFilled } from '../config/site';
import Logo from './Logo.astro';

const telHref = isFilled(SITE.contact.phoneHref) ? `tel:${SITE.contact.phoneHref}` : '/#kontakt';
const waNummer = SITE.contact.whatsapp;
const waText = encodeURIComponent(
  'Hallo, ich interessiere mich für einen Umzug bzw. eine Entrümpelung. Können Sie mir ein Angebot machen?',
);
const waHref = waNummer ? `https://wa.me/${waNummer}?text=${waText}` : '';

const icons = {
  whatsapp:
    '<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24zm-2.5 4.1c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28s-1.44-.71-1.66-.79c-.22-.08-.39-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.45-1.35-1.69-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.79-.19-.46-.39-.4-.54-.41h-.47z"></path>',
  phone: '<path d="M4 5c0 8 7 15 15 15l0-3-4-2-2 2c-2-1-5-4-6-6l2-2-2-4z"></path>',
  haus: '<path d="M20.6 8.4l-8-5.4a1 1 0 0 0-1.2 0l-8 5.4A1 1 0 0 0 3 9.2V20a1 1 0 0 0 1 1h5v-6h6v6h5a1 1 0 0 0 1-1V9.2a1 1 0 0 0-.4-.8z"></path>',
  karton: '<path d="M4 8l8-4 8 4v8l-8 4-8-4z"></path><path d="M4 8l8 4 8-4M12 12v8"></path>',
  lkw: '<path d="M3 7h11v9H3z"></path><path d="M14 10h4l3 3v3h-7"></path><circle cx="7" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle>',
  brief: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
};

/* Vier echte Seiten statt Sprungmarken. Entrümpelung und Privatumzug sind
   die beiden Seiten, auf die auch die Anzeigen laufen. */
const seiten = [
  { href: '/', label: 'Startseite', icon: icons.haus },
  { href: '/leistungen/entruempelung/', label: 'Entrümpelung', icon: icons.karton },
  { href: '/leistungen/privatumzug/', label: 'Umzüge', icon: icons.lkw },
  { href: '/#kontakt', label: 'Kontakt', icon: icons.brief },
];
---
<!-- Sheet: liegt über der Leiste und wird von ihr aus geöffnet -->
<div
  data-cta-sheet
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Menü und Kontakt"
  class="fixed inset-0 z-[70] max-[900px]:block min-[901px]:hidden"
>
  <div data-cta-backdrop class="absolute inset-0 bg-espresso/55 backdrop-blur-[3px]"></div>

  <div
    data-cta-panel
    class="absolute inset-x-3 bottom-[92px] overflow-hidden rounded-[26px] bg-espresso text-white shadow-[0_18px_60px_rgba(42,32,25,.5)]"
  >
    <!-- Kopf: Marke und Begrüßung, damit das Menü nicht wie ein Systemdialog wirkt -->
    <div class="px-5 pb-5 pt-5">
      <div>
        <Logo size="h-9" class="text-white" truckClass="text-accent" />
        <p class="m-0 mt-3.5 text-[17px] font-semibold">
          Schön, dass Sie hier sind <span aria-hidden="true">👋</span>
        </p>
        <p class="m-0 mt-1 text-[14px] text-white/60">
          Umzug oder Entrümpelung? Schreiben Sie uns einfach.
        </p>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="px-3 pb-2" aria-label="Seiten">
      {seiten.map((s) => (
        <a href={s.href} data-cta-close class="menue-zeile">
          <span class="menue-icon" aria-hidden="true">
            <svg width="19" height="19" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          </span>
          {s.label}
          <svg class="ml-auto text-white/35" width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </a>
      ))}
    </nav>

    <!-- Genau zwei Kontaktwege, nicht fünf -->
    <div class:list={['sheet-aktionen grid gap-2.5 border-t border-white/10 p-4', waHref ? 'grid-cols-2' : 'grid-cols-1']}>
      {waHref && (
        <a
          href={waHref}
          target="_blank"
          rel="noopener"
          data-cta-close
          data-contact="whatsapp"
          class="flex min-w-0 items-center justify-center gap-2 rounded-full bg-[#25D366] px-4 py-3.5 text-[15.5px] font-bold text-white"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons.whatsapp} />
          WhatsApp
        </a>
      )}
      <a
        href={telHref}
        data-cta-close
        data-contact="phone"
        class="accent-fill flex min-w-0 items-center justify-center gap-2 rounded-full bg-accent px-4 py-3.5 text-[15.5px] font-bold text-white"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" fill="none" aria-hidden="true" set:html={icons.phone} />
        Anrufen
      </a>
    </div>
  </div>
</div>

<!-- Leiste -->
<div
  data-mobile-cta
  class="mobile-bar fixed inset-x-0 bottom-0 z-[60] hidden gap-2.5 p-[10px_14px_calc(10px+env(safe-area-inset-bottom))] max-[900px]:grid"
>
  {waHref ? (
    <a
      href={waHref}
      target="_blank"
      rel="noopener"
      data-contact="whatsapp"
      data-bar-wa
      class="wa-knopf flex items-center justify-center gap-2 rounded-full p-3.5 text-[16px] font-bold text-white"
    >
      <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons.whatsapp} />
      WhatsApp
    </a>
  ) : (
    <a href={telHref} data-contact="phone" class="flex items-center justify-center gap-2 rounded-full border border-[rgba(42,32,25,.14)] bg-white p-3.5 font-semibold text-ink">
      <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" fill="none" aria-hidden="true" set:html={icons.phone} />
      Anrufen
    </a>
  )}

  <button
    type="button"
    data-cta-toggle
    aria-expanded="false"
    class="flex items-center justify-center gap-2.5 rounded-full border border-[rgba(42,32,25,.14)] bg-white p-3.5 text-[16px] font-semibold text-ink"
  >
    <span class="knopf-zu">
      Menü
      <span class="cta-punkte" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
    </span>
    <span class="knopf-auf">
      Schließen
      <svg width="19" height="19" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </span>
  </button>
</div>

<style is:global>
  /* Erscheint erst nach etwas Scrollen – sonst verdeckt sie die Hero-Knöpfe */
  .mobile-bar {
    transform: translateY(120%);
    opacity: 0;
    transition: transform .34s cubic-bezier(.22, 1, .36, 1), opacity .24s;
    pointer-events: none;
  }
  .mobile-bar.is-sichtbar { transform: none; opacity: 1; pointer-events: auto; }

  /* Zwei exakt gleich breite Spalten. Mit Flexbox waren sie es nicht: Der
     Menue-Knopf hat einen Rahmen, WhatsApp nicht, und Chromium schlaegt
     Rahmen und Innenabstand auf flex-basis:0 noch obendrauf – gemessen 175
     zu 177 Pixel. Unter 360px Breite wurde es mit 149 zu 133 deutlich
     sichtbar, weil "WhatsApp" nicht schmaler wird als sein Inhalt. Grid
     teilt stur in der Mitte, unabhaengig vom Inhalt. */
  .mobile-bar { grid-template-columns: 1fr 1fr; }
  .mobile-bar > * { min-width: 0; }
  /* Sehr schmale Geraete: weniger Innenabstand, damit "WhatsApp" in die halbe
     Breite passt, statt sie zu sprengen. */
  @media (max-width: 360px) {
    .mobile-bar > * { padding-left: 9px; padding-right: 9px; font-size: 15px; }
    /* Im Sheet ist nebeneinander zu eng: dort lief "Anrufen" bei 320px ueber
       den Rand hinaus. Untereinander passt es immer und bleibt gleich breit. */
    .sheet-aktionen { grid-template-columns: 1fr; }
  }

  /* Eigene Flaeche unter den Knoepfen. Ohne sie schweben die beiden Pillen
     ueber dem Inhalt, und laufender Text scheint zwischen ihnen durch – man
     liest dann halbe Zeilen im Zwischenraum. Leicht durchscheinend und
     weichgezeichnet: Man sieht, dass die Seite weitergeht, ohne dass der Text
     mit den Knoepfen konkurriert. Die Farbe folgt der Farbwelt (--cream),
     damit es in allen drei Themes passt. */
  .mobile-bar {
    background: color-mix(in srgb, var(--cream) 78%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    backdrop-filter: blur(16px) saturate(1.6);
    border-top: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }
  /* Weicher Auslauf nach oben, damit die Flaeche nicht als harte Kante mitten
     im Absatz beginnt. */
  .mobile-bar::before {
    content: '';
    position: absolute;
    inset: auto 0 100% 0;
    height: 22px;
    background: linear-gradient(to top, color-mix(in srgb, var(--cream) 60%, transparent), transparent);
    pointer-events: none;
  }
  /* Aeltere Browser ohne backdrop-filter: dann deckend, sonst waere der Text
     dahinter weiterhin lesbar und genau das Problem bliebe. */
  @supports not ((backdrop-filter: blur(4px)) or (-webkit-backdrop-filter: blur(4px))) {
    .mobile-bar { background: color-mix(in srgb, var(--cream) 97%, transparent); }
  }

  .wa-knopf { background: #25D366; box-shadow: 0 6px 18px rgba(37, 211, 102, .34); }
  .wa-knopf:active { background: #1EB558; }

  /* Bei offenem Menue: Leiste ueber den Blur heben, WhatsApp ausblenden und
     den rechten Knopf zum Schliessen machen. Sonst stuende WhatsApp zweimal
     direkt uebereinander, und wie man wieder rauskommt, waere nicht zu sehen. */
  .mobile-bar { z-index: 60; }
  .mobile-bar.ist-offen { z-index: 80; }
  .mobile-bar.ist-offen [data-bar-wa] { display: none; }
  /* Offen bleibt nur der Schliessen-Knopf – der bekommt die ganze Breite */
  .mobile-bar.ist-offen { grid-template-columns: 1fr; }
  /* Bei offenem Menue traegt schon der abgedunkelte Blur des Overlays – eine
     helle Bank unter dem dunklen Sheet saehe nach Versehen aus. */
  .mobile-bar.ist-offen {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-top-color: transparent;
  }
  .mobile-bar.ist-offen::before { display: none; }

  .knopf-zu, .knopf-auf { display: inline-flex; align-items: center; gap: 10px; }
  .knopf-auf { display: none; }
  .mobile-bar.ist-offen .knopf-zu { display: none; }
  .mobile-bar.ist-offen .knopf-auf { display: inline-flex; }

  /* 3x3-Punkteraster */
  .cta-punkte { display: grid; grid-template-columns: repeat(3, 3px); gap: 3px; }
  .cta-punkte i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }

  .menue-zeile {
    display: flex; align-items: center; gap: 14px;
    padding: 13px 14px; border-radius: 14px;
    font-size: 17px; font-weight: 600; color: #fff;
    transition: background .15s;
  }
  .menue-zeile:active { background: rgba(255, 255, 255, .09); }
  .menue-icon {
    display: flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 11px; flex-shrink: 0;
    background: rgba(232, 123, 46, .18); color: var(--accent);
  }

  [data-cta-sheet][hidden] { display: none !important; }
  [data-cta-panel] { animation: sheetHoch .3s cubic-bezier(.22, 1, .36, 1); }
  [data-cta-backdrop] { animation: sheetEin .25s ease; }
  @keyframes sheetHoch { from { transform: translateY(18px); opacity: 0; } }
  @keyframes sheetEin { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .mobile-bar { transition: none; }
    [data-cta-panel], [data-cta-backdrop] { animation: none; }
  }
</style>
