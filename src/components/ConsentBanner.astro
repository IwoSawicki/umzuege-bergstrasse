---
/**
 * Cookie-Consent-Banner (DSGVO/TDDDG) mit Google Consent Mode v2.
 *
 * - Statistik-/Marketing-Skripte (GA4, Google Ads) laden ERST nach Einwilligung.
 * - IDs werden zentral in src/config/site.ts (analytics.gaId / analytics.adsId)
 *   gepflegt. Solange sie leer sind, wird gar nichts geladen – der Banner
 *   speichert die Einwilligung aber schon, sodass sie beim Nachrüsten greift.
 * - Auswahl liegt in localStorage ("ub-consent"); über einen Link mit
 *   data-consent-open (Footer: "Cookie-Einstellungen") jederzeit änderbar.
 */
import { SITE } from '../config/site';
const gaId = SITE.analytics.gaId;
const adsId = SITE.analytics.adsId;
const clarityId = SITE.analytics.clarityId;
---
<div
  id="consent-banner"
  hidden
  role="dialog"
  aria-modal="false"
  aria-label="Cookie-Einstellungen"
  class="fixed bottom-0 right-0 z-[80] w-full max-w-[400px] p-3 sm:bottom-4 sm:right-4 sm:p-0"
>
  <div class="rounded-[18px] border border-[rgba(42,32,25,.1)] bg-white p-4 shadow-[0_14px_44px_rgba(42,32,25,.22)] sm:p-5">
    <h2 class="m-0 mb-1 text-[15.5px] font-bold">🍪 Hat jemand Cookies gesagt?</h2>
    <p class="m-0 mb-3 text-[13px] leading-[1.5] text-muted">
      Wir verwenden Cookies, um auszuwerten, wie unsere Website genutzt wird{adsId ? ' und um unsere Werbung zu messen' : ''}.
      Details in der{' '}<a href="/datenschutz">Datenschutzerklärung</a>.
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-consent-accept class="btn btn-accent !px-4 !py-2 !text-[13.5px]">Alle akzeptieren</button>
      <button type="button" data-consent-decline class="btn btn-outline !px-4 !py-2 !text-[13.5px]">Nur notwendige</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ gaId, adsId, clarityId }}>
  (function () {
    var KEY = 'ub-consent';
    var banner = document.getElementById('consent-banner');
    if (!banner) return;

    // Google Consent Mode v2: Standard = alles verweigert (muss VOR gtag.js stehen)
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = window.gtag || gtag;
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });

    function readChoice() {
      try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
    }
    function saveChoice(granted) {
      try { localStorage.setItem(KEY, JSON.stringify({ granted: granted, ts: Date.now() })); } catch {}
    }

    var scriptsLoaded = false;

    // Microsoft Clarity: Heatmaps und Sitzungsaufzeichnung. Setzt Cookies und
    // ist damit einwilligungspflichtig – wird deshalb erst hier geladen.
    function loadClarity() {
      if (!clarityId || window.clarity) return;
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityId);
    }

    function loadGoogleScripts() {
      if (scriptsLoaded) return;
      var primaryId = gaId || adsId;
      if (!primaryId) return; // noch keine IDs gepflegt → nichts laden
      scriptsLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + primaryId;
      document.head.appendChild(s);
      gtag('js', new Date());
      if (gaId) gtag('config', gaId);
      if (adsId) gtag('config', adsId);
    }

    function applyConsent(granted) {
      if (!granted) return;
      // Werbe-Einwilligung nur erteilen, wenn tatsächlich geworben wird –
      // sonst deckt der Bannertext sie nicht ab.
      var werbung = adsId ? 'granted' : 'denied';
      gtag('consent', 'update', {
        ad_storage: werbung,
        ad_user_data: werbung,
        ad_personalization: werbung,
        analytics_storage: 'granted',
      });
      loadGoogleScripts();
      loadClarity();
    }

    function show() { banner.hidden = false; }
    function hide() { banner.hidden = true; }

    var choice = readChoice();
    if (choice === null) {
      show();
    } else {
      applyConsent(!!choice.granted);
    }

    banner.querySelector('[data-consent-accept]').addEventListener('click', function () {
      saveChoice(true); applyConsent(true); hide();
    });
    banner.querySelector('[data-consent-decline]').addEventListener('click', function () {
      saveChoice(false); hide();
    });

    // "Cookie-Einstellungen"-Links (z. B. im Footer) öffnen den Banner erneut
    document.querySelectorAll('[data-consent-open]').forEach(function (el) {
      el.addEventListener('click', function (e) { e.preventDefault(); show(); });
    });
  })();
</script>
