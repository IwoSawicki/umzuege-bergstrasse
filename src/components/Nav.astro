---
import { NAV, SITE } from '../config/site';
---
<div class="nav-wrap sticky top-[18px] z-50 px-6 max-[560px]:top-[10px] max-[560px]:px-3">
  <nav
    class="mx-auto flex max-w-[960px] items-center justify-between rounded-full bg-white py-3 pl-[22px] pr-[14px] shadow-[0_10px_40px_rgba(42,32,25,.10)] max-[560px]:py-2 max-[560px]:pl-4 max-[560px]:pr-2"
  >
    <a href="/#top" class="flex items-center gap-[11px] text-ink" aria-label={`${SITE.name} – Startseite`}>
      <span
        class="flex h-[42px] w-[42px] flex-shrink-0 items-center justify-center rounded-xl bg-espresso text-[17px] font-extrabold text-white"
        >{SITE.shortName}</span
      >
      <span class="flex flex-col leading-none">
        <span class="text-[17.5px] font-extrabold tracking-tight text-ink">UMZÜGE</span>
        <span class="text-[11.5px] font-extrabold tracking-[.02em] text-ink">BERGSTRASSE</span>
      </span>
    </a>

    <div class="nav-links flex items-center gap-[34px] max-[900px]:hidden">
      {NAV.map((item) => (
        <a href={item.href} class="nav-link font-medium text-ink">{item.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a href="/#kontakt" class="btn btn-accent btn-sm nav-cta max-[900px]:hidden !px-[22px] !py-[13px] !text-[15px]">Kostenlos anfragen</a>
      <button
        class="burger hidden h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-[rgba(42,32,25,.14)] bg-white max-[900px]:inline-flex"
        type="button"
        data-menu-toggle
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"
          ><path d="M3 6h18M3 12h18M3 18h18"></path></svg
        >
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    hidden
    class="mx-auto mt-2 max-w-[960px] flex-col gap-1 rounded-[22px] bg-white p-[14px] shadow-[0_10px_40px_rgba(42,32,25,.10)]"
  >
    {NAV.map((item) => (
      <a href={item.href} data-menu-close class="px-3 py-[10px] font-medium text-ink">{item.label}</a>
    ))}
  </div>
</div>
