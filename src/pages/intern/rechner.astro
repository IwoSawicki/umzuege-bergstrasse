---
/**
 * Interner Angebotsrechner – nicht verlinkt, nicht indexiert.
 *
 * Bewusst ohne BaseLayout: kein Consent-Banner, kein Analytics, keine
 * Navigation. Die Seite zeigt interne Kostenstrukturen und soll weder
 * in der Suche noch in der Sitemap auftauchen. Zusätzlich abgesichert
 * über robots.txt (Disallow: /intern/) und den Sitemap-Filter in
 * astro.config.mjs.
 *
 * Die Kostenannahmen liegen im localStorage des jeweiligen Geräts.
 */
import '../../styles/global.css';

const groessen = [
  { std: 8, label: '1 Zimmer / Apartment' },
  { std: 13, label: '2 Zimmer' },
  { std: 19, label: '3 Zimmer', selected: true },
  { std: 26, label: '4 Zimmer' },
  { std: 36, label: '5+ Zimmer / Haus' },
];
const objekte = [
  { m3: 8, label: 'Keller oder Dachboden' },
  { m3: 15, label: 'Garage' },
  { m3: 22, label: '1-Zimmer-Wohnung' },
  { m3: 32, label: '2-Zimmer-Wohnung' },
  { m3: 45, label: '3-Zimmer-Wohnung', selected: true },
  { m3: 60, label: '4-Zimmer-Wohnung' },
  { m3: 95, label: 'Haus' },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <title>Angebotsrechner · intern</title>
    <meta name="theme-color" content="#14100E" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="rechner">
    <!-- Sperre. Der Inhalt startet mit hidden und wird erst per JavaScript
         freigegeben – ohne JavaScript bleibt die Seite leer. -->
    <div class="gate" id="gate">
      <form class="gate-card" id="gate-form">
        <div class="gate-mark" aria-hidden="true">UB</div>
        <label class="gate-label" for="pin">Vier Zahlen eingeben</label>
        <input
          id="pin" type="password" inputmode="numeric" pattern="[0-9]*"
          maxlength="4" autocomplete="off" autofocus
          aria-describedby="gate-msg"
        />
        <p class="gate-msg" id="gate-msg" role="status">Der Code bleibt auf diesem Gerät gespeichert.</p>
      </form>
    </div>

    <div class="wrap-r" id="inhalt" hidden>
      <header class="head-r">
        <p class="eyebrow-r" id="eyebrow">Umzüge Bergstraße · nur intern</p>
        <h1>Festpreis in 60&nbsp;Sekunden</h1>
        <p class="sub-r" id="sub">
          Angaben aus der Besichtigung eintragen, Preis ablesen. Unten steht, was nach Löhnen,
          Fahrzeug und Entsorgung übrig bleibt.
        </p>
      </header>

      <div class="modes" role="group" aria-label="Art des Auftrags">
        <button class="mode" id="m-umzug" type="button" aria-pressed="true">
          Umzug<small>Privat oder Firma</small>
        </button>
        <button class="mode" id="m-entr" type="button" aria-pressed="false">
          Entrümpelung<small>Auflösung, Keller, Räumung</small>
        </button>
      </div>

      <form id="form" novalidate>
        <fieldset id="fs-umzug">
          <div class="row-r">
            <label for="u-groesse">Wohnungsgröße<span class="hint">Bestimmt die geschätzten Mannstunden</span></label>
            <select id="u-groesse">
              {groessen.map((g) => <option value={g.std} selected={g.selected}>{g.label}</option>)}
            </select>
          </div>
          <div class="row-r">
            <label for="u-etagen">Etagen ohne Aufzug<span class="hint">Beide Adressen zusammen</span></label>
            <input type="number" id="u-etagen" min="0" max="12" step="1" value="2" inputmode="numeric" />
          </div>
          <div class="row-r">
            <label for="u-km">Entfernung in km<span class="hint">Erste 20 km sind im Grundpreis</span></label>
            <input type="number" id="u-km" min="0" max="400" step="1" value="12" inputmode="numeric" />
          </div>
          <div class="row-r">
            <label for="u-helfer">Helfer im Team<span class="hint">Bestimmt, ob es ein oder zwei Tage werden</span></label>
            <input type="number" id="u-helfer" min="1" max="8" step="1" value="3" inputmode="numeric" />
          </div>
          <div class="checks">
            <button class="chk" type="button" data-flag="pack" aria-pressed="false">Packservice</button>
            <button class="chk" type="button" data-flag="hvz" aria-pressed="false">Halteverbotszone</button>
            <button class="chk" type="button" data-flag="kueche" aria-pressed="false">Küche ab- und aufbauen</button>
          </div>
        </fieldset>

        <fieldset id="fs-entr" hidden>
          <div class="row-r">
            <label for="e-objekt">Objekt<span class="hint">Setzt das Volumen vor</span></label>
            <select id="e-objekt">
              {objekte.map((o) => <option value={o.m3} selected={o.selected}>{o.label}</option>)}
            </select>
          </div>
          <div class="row-r">
            <label for="e-volumen">Volumen in m³<span class="hint">Nach Augenschein korrigieren</span></label>
            <input type="number" id="e-volumen" min="1" max="300" step="1" value="45" inputmode="numeric" />
          </div>
          <div class="row-r">
            <label for="e-etagen">Etagen ohne Aufzug</label>
            <input type="number" id="e-etagen" min="0" max="12" step="1" value="1" inputmode="numeric" />
          </div>
          <div class="row-r">
            <label for="e-helfer">Helfer im Team<span class="hint">Bestimmt die Anzahl Einsatztage</span></label>
            <input type="number" id="e-helfer" min="1" max="8" step="1" value="2" inputmode="numeric" />
          </div>
          <div class="row-r">
            <label for="e-wert">Wertanrechnung in €<span class="hint">Verwertbare Möbel, Metall, Elektro</span></label>
            <input type="number" id="e-wert" min="0" max="5000" step="10" value="0" inputmode="numeric" />
          </div>
          <div class="checks">
            <button class="chk" type="button" data-flag="messie" aria-pressed="false">Stark vermüllt</button>
            <button class="chk" type="button" data-flag="besen" aria-pressed="true">Besenrein übergeben</button>
            <button class="chk" type="button" data-flag="hvz2" aria-pressed="false">Halteverbotszone</button>
          </div>
        </fieldset>
      </form>

      <div class="result-r">
        <div class="lbl-r">Angebotspreis, brutto</div>
        <div class="price-r" id="preis">1.780 €</div>
        <div class="note-r" id="preis-note">19 Mannstunden · 1 Einsatztag · inkl. 19 % MwSt.</div>
        <p class="say-r" id="say">
          Am Telefon: <strong id="satz">„Für Ihre 3-Zimmer-Wohnung liegen wir bei 1.780 € –
          als Festpreis, nach der Besichtigung schriftlich."</strong>{' '}Keine Spanne nennen,
          keine Stundensätze.
        </p>
      </div>

      <button class="toggle-r" id="toggle" type="button" aria-expanded="true" aria-controls="intern-bereich">
        <span id="toggle-text">Interne Zahlen ausblenden</span>
        <span class="toggle-ico" aria-hidden="true">▾</span>
      </button>

      <div id="intern-bereich">
      <section class="intern-r" aria-label="Interne Kontrolle">
        <div class="intern-head">
          <span>Intern · nicht zeigen</span>
          <span class="verdict ok" id="verdict">640 € je Tag · 54 %</span>
        </div>
        <div class="bar"><i id="bar" style="width:54%"></i></div>
        <div class="lines" id="lines"></div>
      </section>

      <details class="ann-r">
        <summary>Kostenannahmen anpassen</summary>
        <p>
          Startwerte. Ersetze sie nach den ersten drei Aufträgen durch die echten Zahlen – vor allem
          den Entsorgungspreis, der schwankt stark nach Material und Deponie. Die Werte bleiben auf
          diesem Gerät gespeichert.
        </p>
        <div class="row-r">
          <label for="a-vk">Verkauf je Mannstunde<span class="hint">Was der Kunde zahlt</span></label>
          <input type="number" id="a-vk" min="30" max="120" step="1" value="60" inputmode="numeric" />
        </div>
        <div class="row-r">
          <label for="a-lohn">Kosten je Mannstunde<span class="hint">Helferlohn inkl. Nebenkosten</span></label>
          <input type="number" id="a-lohn" min="10" max="45" step="0.5" value="16" inputmode="decimal" />
        </div>
        <div class="row-r">
          <label for="a-fzg">Fahrzeug je Einsatztag<span class="hint">Miete oder Leasinganteil plus Sprit</span></label>
          <input type="number" id="a-fzg" min="40" max="400" step="5" value="120" inputmode="numeric" />
        </div>
        <div class="row-r">
          <label for="a-ents">Entsorgung je m³<span class="hint">Deponie- und Wertstoffhofgebühren</span></label>
          <input type="number" id="a-ents" min="10" max="150" step="1" value="42" inputmode="numeric" />
        </div>
        <div class="row-r">
          <label for="a-aufschlag">Aufschlag auf Entsorgung in %<span class="hint">Deckt Deponiefahrten und Sortieren</span></label>
          <input type="number" id="a-aufschlag" min="0" max="200" step="5" value="35" inputmode="numeric" />
        </div>
        <div class="row-r">
          <label for="a-dbtag">Ziel-Deckungsbeitrag je Einsatztag<span class="hint">Fixkosten geteilt durch Einsatztage im Monat</span></label>
          <input type="number" id="a-dbtag" min="100" max="2000" step="10" value="600" inputmode="numeric" />
        </div>
        <div class="row-r">
          <label for="a-min">Mindestauftragswert<span class="hint">Darunter lohnt kein Anfahrtstag</span></label>
          <input type="number" id="a-min" min="0" max="2000" step="10" value="450" inputmode="numeric" />
        </div>
        <button class="reset-r" id="reset" type="button">Auf Startwerte zurücksetzen</button>
      </details>

      </div>

      <div class="lock-row">
        <button class="reset-r" id="sperren" type="button">Sperren</button>
      </div>

      <footer class="foot-r" id="foot">
        Interne Seite · nicht verlinkt, nicht indexiert · Preis erst nach Besichtigung verbindlich
      </footer>
    </div>

    <style is:global>
      /* Dunkle Oberflaeche: der Rechner wird meist in halbdunklen Wohnungen,
         Kellern und Treppenhaeusern benutzt. Eigene Tokens, damit die
         Farbwelt der oeffentlichen Website unberuehrt bleibt.
         color-scheme:dark laesst auch Auswahlfelder und Zahlenpfeile
         nativ dunkel rendern. */
      body.rechner {
        color-scheme: dark;
        --r-bg:       #14100E;
        --r-surface:  #1D1815;
        --r-raised:   #251E19;
        --r-text:     #F3EDE6;
        --r-dim:      #C3B7AB;
        --r-muted:    #968A7D;
        --r-rule:     #362D27;
        --r-rule-2:   #2A231E;
        --r-accent:   #F08A3E;
        --r-accent-2: #F5A868;
        --r-good:     #7CB694;
        --r-mid:      #D7B05A;
        --r-bad:      #E5825F;

        background: var(--r-bg);
        color: var(--r-text);
        padding: 0 16px calc(40px + env(safe-area-inset-bottom));
      }
      .wrap-r { max-width: 720px; margin-inline: auto; }

      /* Sperrbildschirm */
      .gate {
        position: fixed; inset: 0; z-index: 50;
        display: flex; align-items: center; justify-content: center; padding: 24px;
        background: var(--r-bg);
      }
      .gate[hidden] { display: none; }
      .gate-card {
        width: 100%; max-width: 300px; text-align: center;
        display: flex; flex-direction: column; align-items: center; gap: 14px;
      }
      .gate-mark {
        width: 54px; height: 54px; border-radius: 14px;
        background: var(--r-accent); color: var(--r-bg);
        display: grid; place-items: center;
        font-weight: 800; font-size: 19px; letter-spacing: .04em;
      }
      .gate-label { font-weight: 700; font-size: 16px; color: var(--r-text); }
      #pin {
        width: 100%; font: inherit; font-size: 30px; font-weight: 700;
        letter-spacing: .5em; text-indent: .5em; text-align: center;
        background: var(--r-surface); color: var(--r-text);
        border: 1.5px solid var(--r-rule); border-radius: 12px; padding: 14px 10px;
      }
      #pin:focus-visible { outline: 2px solid var(--r-accent); outline-offset: 2px; border-color: var(--r-accent); }
      .gate-msg { margin: 0; font-size: 13.5px; color: var(--r-muted); min-height: 2.6em; }
      .gate-msg.fehler { color: var(--r-bad); }
      .gate-card.schuettel { animation: schuettel .3s; }
      @keyframes schuettel {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-7px); }
        75% { transform: translateX(7px); }
      }

      /* Aufklappen der internen Zahlen */
      .toggle-r {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        width: 100%; margin-top: 22px; cursor: pointer;
        font: inherit; font-size: 14.5px; font-weight: 700; color: var(--r-muted);
        background: var(--r-surface); border: 1px solid var(--r-rule);
        border-radius: 12px; padding: 13px 16px;
      }
      .toggle-r:hover { color: var(--r-text); border-color: var(--r-muted); }
      .toggle-r:focus-visible { outline: 2px solid var(--r-accent); outline-offset: 2px; }
      .toggle-ico { transition: transform .2s; }
      .toggle-r[aria-expanded='false'] .toggle-ico { transform: rotate(-90deg); }
      #intern-bereich[hidden] { display: none; }
      .lock-row { margin-top: 22px; }

      .head-r { padding: 30px 0 18px; }
      .eyebrow-r {
        margin: 0 0 8px; font-size: 11.5px; font-weight: 700; letter-spacing: .15em;
        text-transform: uppercase; color: var(--r-accent-2);
      }
      .head-r h1 {
        margin: 0 0 8px; font-size: clamp(28px, 6.5vw, 40px); font-weight: 800;
        letter-spacing: -.03em; line-height: 1.03; text-wrap: balance; color: var(--r-text);
      }
      .sub-r { margin: 0; color: var(--r-dim); font-size: 15.5px; max-width: 54ch; }

      /* Moduswahl */
      .modes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 20px 0 4px; }
      .mode {
        font: inherit; font-weight: 700; text-align: left; cursor: pointer;
        background: var(--r-surface); color: var(--r-muted);
        border: 1.5px solid transparent; border-radius: 12px; padding: 13px 15px;
        transition: border-color .15s, background .15s, color .15s;
      }
      .mode small { display: block; font-weight: 500; font-size: 12.5px; color: var(--r-muted); margin-top: 2px; }
      .mode[aria-pressed='true'] { background: var(--r-raised); border-color: var(--r-accent); color: var(--r-text); }
      .mode:focus-visible { outline: 2px solid var(--r-accent); outline-offset: 2px; }

      /* Eingabezeilen */
      fieldset { border: 0; margin: 0; padding: 0; }
      .row-r {
        display: grid; grid-template-columns: 1fr auto; gap: 10px 16px; align-items: center;
        padding: 13px 0; border-bottom: 1px solid var(--r-rule-2);
      }
      .row-r label { font-weight: 600; color: var(--r-text); }
      .hint { display: block; font-weight: 400; font-size: 13px; color: var(--r-muted); margin-top: 1px; }
      .row-r select, .row-r input[type='number'] {
        font: inherit; font-variant-numeric: tabular-nums;
        background: var(--r-surface); color: var(--r-text);
        border: 1.5px solid var(--r-rule); border-radius: 10px;
        padding: 11px 13px; width: auto; min-width: 150px;
      }
      .row-r input[type='number'] { text-align: right; }
      .row-r select:focus-visible, .row-r input:focus-visible {
        outline: 2px solid var(--r-accent); outline-offset: 1px; border-color: var(--r-accent);
      }

      .checks { display: flex; flex-wrap: wrap; gap: 8px; padding: 15px 0 4px; }
      .chk {
        font: inherit; font-size: 14.5px; font-weight: 600; cursor: pointer;
        background: var(--r-surface); color: var(--r-muted);
        border: 1.5px solid transparent; border-radius: 999px; padding: 9px 15px;
        transition: border-color .15s, background .15s, color .15s;
      }
      .chk[aria-pressed='true'] { background: var(--r-raised); border-color: var(--r-accent); color: var(--r-text); }
      .chk:focus-visible { outline: 2px solid var(--r-accent); outline-offset: 2px; }

      /* Ergebnis – hellste Flaeche der Seite, Preis in der Markenfarbe */
      .result-r {
        background: var(--r-raised); border: 1px solid var(--r-rule);
        border-radius: 18px; padding: 22px 24px; margin-top: 24px;
      }
      .lbl-r { font-size: 11.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--r-muted); }
      .price-r {
        font-size: clamp(42px, 11vw, 62px); font-weight: 800; letter-spacing: -.045em;
        line-height: 1; margin: 10px 0 5px; font-variant-numeric: tabular-nums;
        color: var(--r-accent);
      }
      .note-r { font-size: 14px; color: var(--r-muted); }
      .say-r {
        margin: 18px 0 0; padding-top: 16px; border-top: 1px solid var(--r-rule);
        font-size: 15px; color: var(--r-dim);
      }
      .say-r strong { color: var(--r-text); }

      /* Interne Kontrolle */
      .intern-r {
        margin-top: 10px; border: 1px solid var(--r-rule);
        border-radius: 14px; overflow: hidden; background: var(--r-surface);
      }
      .intern-head {
        display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
        background: var(--r-raised); padding: 12px 16px;
      }
      .intern-head span:first-child {
        font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--r-muted);
      }
      .verdict { font-weight: 800; font-size: 15px; font-variant-numeric: tabular-nums; text-align: right; }
      .verdict.ok { color: var(--r-good); }
      .verdict.mid { color: var(--r-mid); }
      .verdict.bad { color: var(--r-bad); }
      .bar { height: 6px; background: var(--r-rule-2); }
      .bar i { display: block; height: 100%; width: 0; background: var(--r-good); transition: width .25s ease; }
      .bar i.mid { background: var(--r-mid); }
      .bar i.bad { background: var(--r-bad); }
      .lines { padding: 4px 16px 14px; }
      .line {
        display: flex; justify-content: space-between; gap: 16px; padding: 9px 0;
        border-bottom: 1px solid var(--r-rule-2); font-size: 15px; color: var(--r-dim);
      }
      .line:last-child { border-bottom: 0; }
      .line span:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--r-text); }
      .line.total {
        font-weight: 800; color: var(--r-text); border-bottom: 0;
        border-top: 1.5px solid var(--r-rule); margin-top: 5px; padding-top: 11px;
      }

      /* Annahmen */
      .ann-r { margin-top: 24px; border-top: 1px solid var(--r-rule); padding-top: 16px; }
      .ann-r summary { cursor: pointer; font-weight: 700; color: var(--r-text); }
      .ann-r summary::marker { color: var(--r-accent); }
      .ann-r > p { color: var(--r-muted); font-size: 14.5px; max-width: 60ch; }
      .reset-r {
        font: inherit; font-size: 12.5px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase;
        background: none; border: 1px solid var(--r-rule); border-radius: 8px;
        color: var(--r-muted); padding: 8px 13px; cursor: pointer; margin-top: 14px;
      }
      .reset-r:hover { color: var(--r-text); border-color: var(--r-muted); }

      .foot-r {
        margin-top: 30px; padding-top: 16px; border-top: 1px solid var(--r-rule);
        font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--r-muted);
      }

      @media (max-width: 520px) {
        .row-r { grid-template-columns: 1fr; gap: 6px; }
        .row-r select, .row-r input[type='number'] { width: 100%; min-width: 0; text-align: left; }
        .intern-head { flex-direction: column; align-items: flex-start; gap: 4px; }
        .verdict { text-align: left; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>

    <script is:inline>
      (function () {
        // ---------------------------------------------------------------
        // Zugangscode. Hier aendern, wenn ein anderer Code gewuenscht ist.
        // Wichtig: Das ist ein Sichtschutz, kein Schutz gegen jemanden, der
        // sich auskennt – die Seite wird als statische Datei ausgeliefert.
        // Echten Schutz gaebe es nur serverseitig (Basic Auth im nginx).
        // ---------------------------------------------------------------
        var CODE = '4444';

        var KEY = 'ub-rechner-annahmen';
        var KEY_AUF = 'ub-rechner-offen';
        var KEY_ZUGANG = 'ub-rechner-zugang';
        var DEF = { vk: 60, lohn: 16, fzg: 120, ents: 42, aufschlag: 35, dbtag: 600, min: 450 };
        var mode = 'umzug';
        var flags = { pack: false, hvz: false, kueche: false, messie: false, besen: true, hvz2: false };

        function $(id) { return document.getElementById(id); }
        function eur(n) { return Math.round(n).toLocaleString('de-DE') + ' €'; }

        function annahmen() {
          return {
            vk: +$('a-vk').value || DEF.vk,
            lohn: +$('a-lohn').value || DEF.lohn,
            fzg: +$('a-fzg').value || DEF.fzg,
            ents: +$('a-ents').value || DEF.ents,
            aufschlag: +$('a-aufschlag').value || 0,
            dbtag: +$('a-dbtag').value || DEF.dbtag,
            min: +$('a-min').value || 0,
          };
        }
        function speichern() {
          try { localStorage.setItem(KEY, JSON.stringify(annahmen())); } catch (e) {}
        }
        function laden() {
          try {
            var v = JSON.parse(localStorage.getItem(KEY) || 'null');
            if (!v) return;
            ['vk', 'lohn', 'fzg', 'ents', 'aufschlag', 'dbtag', 'min'].forEach(function (k) {
              if (typeof v[k] === 'number') $('a-' + k).value = v[k];
            });
          } catch (e) {}
        }

        function rechnen() {
          var a = annahmen();
          var std = 0, m3 = 0, zuschlag = 0, abzug = 0, hvz = 0, helfer = 3;

          if (mode === 'umzug') {
            helfer = Math.max(1, +$('u-helfer').value || 3);
            std = +$('u-groesse').value;
            std += (+$('u-etagen').value || 0) * 1.2;
            if (flags.pack) std *= 1.4;
            if (flags.kueche) std += 4;
            zuschlag += Math.max(0, (+$('u-km').value || 0) - 20) * 0.9;
            if (flags.hvz) { hvz = 260; zuschlag += hvz; }
          } else {
            helfer = Math.max(1, +$('e-helfer').value || 2);
            m3 = +$('e-volumen').value || 0;
            std = m3 * 0.65;
            std += (+$('e-etagen').value || 0) * 1.2;
            if (flags.messie) std *= 1.35;
            if (flags.besen) std += 2;
            abzug = +$('e-wert').value || 0;
            if (flags.hvz2) { hvz = 130; zuschlag += hvz; }
          }

          // Ein Einsatztag sind acht Stunden je Helfer
          var tage = Math.max(1, Math.ceil(std / (helfer * 8)));
          var entsorgung = m3 * a.ents;
          var roh = std * a.vk + tage * a.fzg + zuschlag
                  + entsorgung * (1 + a.aufschlag / 100) - abzug;
          var preis = Math.max(a.min, Math.round(roh / 10) * 10);

          var kLohn = std * a.lohn;
          var kFzg = tage * a.fzg;
          var kosten = kLohn + kFzg + entsorgung;
          var db = preis - kosten;
          var quote = preis > 0 ? db / preis : 0;

          $('preis').textContent = eur(preis);

          // Der Satz fuers Telefon muss denselben Preis nennen wie die Anzeige
          var objekt = mode === 'umzug'
            ? $('u-groesse').options[$('u-groesse').selectedIndex].text
            : $('e-objekt').options[$('e-objekt').selectedIndex].text;
          $('satz').textContent =
            '„Für ' + (mode === 'umzug' ? 'Ihren Umzug (' + objekt + ')' : 'die Räumung (' + objekt + ')') +
            ' liegen wir bei ' + eur(preis) + ' – als Festpreis, nach der Besichtigung schriftlich."';
          $('preis-note').textContent =
            std.toFixed(0) + ' Mannstunden · ' + helfer + ' Helfer · ' +
            tage + (tage === 1 ? ' Einsatztag' : ' Einsatztage') +
            (m3 ? ' · ' + m3 + ' m³' : '') + ' · inkl. 19 % MwSt.';

          var rows = [
            ['Löhne (' + std.toFixed(0) + ' Mannstunden × ' + a.lohn + ' €)', kLohn],
            ['Fahrzeug (' + tage + ' × ' + a.fzg + ' €)', kFzg],
          ];
          if (m3) rows.push(['Entsorgung (' + m3 + ' m³ × ' + a.ents + ' €)', entsorgung]);
          if (hvz) rows.push(['davon Halteverbotszone (durchlaufend)', hvz]);
          if (abzug) rows.push(['Wertanrechnung abgezogen', -abzug]);

          var box = $('lines');
          box.textContent = '';
          rows.forEach(function (r) {
            var d = document.createElement('div');
            d.className = 'line';
            var l = document.createElement('span'); l.textContent = r[0];
            var v = document.createElement('span'); v.textContent = eur(r[1]);
            d.appendChild(l); d.appendChild(v); box.appendChild(d);
          });
          var t = document.createElement('div');
          t.className = 'line total';
          var tl = document.createElement('span'); tl.textContent = 'Bleibt als Deckungsbeitrag';
          var tv = document.createElement('span'); tv.textContent = eur(db);
          t.appendChild(tl); t.appendChild(tv); box.appendChild(t);

          var d2 = document.createElement('div');
          d2.className = 'line';
          var d2l = document.createElement('span'); d2l.textContent = 'davon je Einsatztag';
          var d2v = document.createElement('span'); d2v.textContent = eur(db / tage);
          d2.appendChild(d2l); d2.appendChild(d2v); box.appendChild(d2);

          // Bewertet wird der Deckungsbeitrag je Einsatztag, nicht die Quote:
          // Entsorgung ist ein Durchlaufposten und drueckt die Quote, ohne dass
          // der Auftrag deshalb schlecht waere.
          var dbTag = db / tage;
          var pct = Math.max(0, Math.min(100, quote * 100));
          var cls = dbTag >= a.dbtag ? 'ok' : dbTag >= a.dbtag * 0.7 ? 'mid' : 'bad';
          var v = $('verdict');
          v.className = 'verdict ' + cls;
          v.textContent = eur(dbTag) + ' je Tag · ' + pct.toFixed(0) + ' %' +
            (cls === 'bad' ? ' · zu wenig' : cls === 'mid' ? ' · knapp' : '');
          var bar = $('bar');
          bar.style.width = Math.max(0, Math.min(100, (dbTag / a.dbtag) * 100)).toFixed(0) + '%';
          bar.className = cls === 'ok' ? '' : cls;
        }

        function setMode(m) {
          mode = m;
          $('m-umzug').setAttribute('aria-pressed', String(m === 'umzug'));
          $('m-entr').setAttribute('aria-pressed', String(m !== 'umzug'));
          $('fs-umzug').hidden = m !== 'umzug';
          $('fs-entr').hidden = m === 'umzug';
          rechnen();
        }
        $('m-umzug').addEventListener('click', function () { setMode('umzug'); });
        $('m-entr').addEventListener('click', function () { setMode('entruempelung'); });

        document.querySelectorAll('.chk').forEach(function (b) {
          b.addEventListener('click', function () {
            var f = b.dataset.flag;
            flags[f] = !flags[f];
            b.setAttribute('aria-pressed', String(flags[f]));
            rechnen();
          });
        });

        $('e-objekt').addEventListener('change', function () {
          $('e-volumen').value = this.value;
          rechnen();
        });

        document.querySelectorAll('select, input[type=number]').forEach(function (el) {
          el.addEventListener('input', function () {
            if (el.id.indexOf('a-') === 0) speichern();
            rechnen();
          });
        });

        $('reset').addEventListener('click', function () {
          Object.keys(DEF).forEach(function (k) { $('a-' + k).value = DEF[k]; });
          speichern();
          rechnen();
        });

        // ---------- Sperre ----------
        var gate = $('gate'), pin = $('pin'), msg = $('gate-msg'), inhalt = $('inhalt');

        function freigeben() {
          gate.hidden = true;
          inhalt.hidden = false;
        }
        function sperren() {
          try { localStorage.removeItem(KEY_ZUGANG); } catch (e) {}
          inhalt.hidden = true;
          gate.hidden = false;
          pin.value = '';
          msg.className = 'gate-msg';
          msg.textContent = 'Der Code bleibt auf diesem Gerät gespeichert.';
          pin.focus();
        }
        function pruefen() {
          if (pin.value === CODE) {
            try { localStorage.setItem(KEY_ZUGANG, CODE); } catch (e) {}
            freigeben();
            return;
          }
          msg.className = 'gate-msg fehler';
          msg.textContent = 'Falscher Code. Nochmal versuchen.';
          pin.value = '';
          var card = document.getElementById('gate-form');
          card.classList.remove('schuettel');
          void card.offsetWidth;
          card.classList.add('schuettel');
          pin.focus();
        }

        pin.addEventListener('input', function () {
          pin.value = pin.value.replace(/\D/g, '').slice(0, 4);
          if (msg.className.indexOf('fehler') > -1 && pin.value.length) {
            msg.className = 'gate-msg';
            msg.textContent = 'Der Code bleibt auf diesem Gerät gespeichert.';
          }
          if (pin.value.length === 4) pruefen();
        });
        $('gate-form').addEventListener('submit', function (e) { e.preventDefault(); pruefen(); });
        $('sperren').addEventListener('click', sperren);

        var frei = false;
        try { frei = localStorage.getItem(KEY_ZUGANG) === CODE; } catch (e) {}
        if (frei) freigeben(); else pin.focus();

        // ---------- Interne Zahlen auf-/zuklappen ----------
        var toggle = $('toggle'), bereich = $('intern-bereich'), tText = $('toggle-text');
        var annBlock = document.querySelector('.ann-r');

        // Zugeklappt heisst: das Handy kann dem Kunden gezeigt werden.
        // Deshalb verschwinden auch der erklaerende Untertitel und der
        // Gespraechsleitfaden – beide verraten die interne Sicht.
        var eyebrow = $('eyebrow'), sub = $('sub'), say = $('say'), foot = $('foot');
        var TXT = {
          intern: {
            eyebrow: 'Umzüge Bergstraße · nur intern',
            sub: 'Angaben aus der Besichtigung eintragen, Preis ablesen. Unten steht, was nach Löhnen, Fahrzeug und Entsorgung übrig bleibt.',
            foot: 'Interne Seite · nicht verlinkt, nicht indexiert · Preis erst nach Besichtigung verbindlich',
          },
          kunde: {
            eyebrow: 'Umzüge Bergstraße',
            sub: 'Ihr unverbindliches Festpreisangebot auf Basis der Besichtigung.',
            foot: 'Umzüge Bergstraße · Festpreis nach kostenloser Besichtigung · keine versteckten Kosten',
          },
        };

        function setOffen(offen) {
          var t = offen ? TXT.intern : TXT.kunde;
          toggle.setAttribute('aria-expanded', String(offen));
          bereich.hidden = !offen;
          if (annBlock) annBlock.hidden = !offen;
          if (say) say.hidden = !offen;
          eyebrow.textContent = t.eyebrow;
          sub.textContent = t.sub;
          if (foot) foot.textContent = t.foot;
          tText.textContent = offen ? 'Interne Zahlen ausblenden' : 'Interne Zahlen anzeigen';
          try { localStorage.setItem(KEY_AUF, offen ? '1' : '0'); } catch (e) {}
        }
        toggle.addEventListener('click', function () {
          setOffen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        var offen = true;
        try { offen = localStorage.getItem(KEY_AUF) !== '0'; } catch (e) {}
        setOffen(offen);

        laden();
        rechnen();
      })();
    </script>
  </body>
</html>
